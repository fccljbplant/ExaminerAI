{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "bash scripts/vercel-build.sh",
  "installCommand": "bun install",
  "functions": {
    "src/app/api/ai/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/courses/generate/**/*.ts": {
      "maxDuration": 300
    },
    "src/app/api/project/generate-tasks/**/*.ts": {
      "maxDuration": 180
    },
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/legacy",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/saas-daily",
      "schedule": "0 4 * * *"
    }
  ],
  "github": {
    "silent": false
  }
}

