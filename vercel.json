{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "bash scripts/vercel-build.sh",
  "installCommand": "bun install",
  "functions": {
    "src/app/api/ai/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/courses/generate/**/*.ts": {
      "maxDuration": 300
    },
    "src/app/api/project/generate-tasks/**/*.ts": {
      "maxDuration": 180
    },
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/srs-due",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/study-plan-refresh",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/absence-scan",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/compliance-expiry",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/trials-expiry",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/billing-dunning",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/payouts-sweep",
      "schedule": "0 5 1 * *"
    },
    {
      "path": "/api/cron/ai-budget-alerts",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/audit-retention",
      "schedule": "0 10 * * 0"
    }
  ],
  "github": {
    "silent": false
  }
}

