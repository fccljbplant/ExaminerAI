{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "bash scripts/vercel-build.sh",
  "installCommand": "bun install",
  "functions": {
    "src/app/api/ai/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/courses/generate/**/*.ts": {
      "maxDuration": 300
    },
    "src/app/api/project/generate-tasks/**/*.ts": {
      "maxDuration": 180
    }
  },
  "crons": [
    {
      "path": "/api/students/check-alerts?secret=${CRON_SECRET}",
      "schedule": "0 9 * * *"
    }
  ],
  "github": {
    "silent": false
  }
}

