# ============================================================
# AI Examiner — Environment Variables
# ============================================================

# ---- DATABASE_URL ----
# Two backends supported:
#
# 1. LOCAL DEV (default — zero setup)
#    SQLite file. The default schema (prisma/schema.prisma) uses SQLite.
#    DATABASE_URL=file:./db/custom.db
#    Then: bun run db:push
#
# 2. PRODUCTION (Vercel / serverless)
#    SQLite does NOT work on Vercel (read-only filesystem). Use Postgres.
#    The production schema is prisma/schema.prod.prisma.
#    Get a free Postgres URL from:
#      - Neon:          https://neon.tech      (recommended, 1-click Vercel integration)
#      - Supabase:      https://supabase.com
#      - Vercel Postgres: https://vercel.com/docs/storage/vercel-postgres
#    DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/examiner_ai?sslmode=require
#    Then: bun run db:push:prod
#
# ============================================================

# === CHOOSE ONE (uncomment the one you want) ===

# Local dev (SQLite):
DATABASE_URL=file:./db/custom.db

# Production (Vercel — Neon Postgres):
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/examiner_ai?sslmode=require

# ---- JWT ----
# JWT signing secret (CHANGE IN PRODUCTION! Use a long random string)
# JWT_SECRET=change-me-in-production
# JWT_EXPIRY=7d

# ---- Admin Account ----
# REQUIRED in production — no hardcoded fallback if not set.
# In dev, defaults to admin@examiner.ai / helloworld
ADMIN_EMAIL=admin@examiner.ai
ADMIN_PASSWORD=change-this-to-a-strong-password

# ---- Z.ai API (PRIMARY AI provider) ----
# Get an API key from Z.ai
# This is the primary provider — all AI features use this first.
ZAI_API_KEY=your-zai-api-key-here

# Z.ai model (optional — defaults to glm-4.6)
# ZAI_MODEL=glm-4.6

# Z.ai base URL (optional — defaults to https://api.z.ai/api/paas/v4)
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# ---- DeepSeek AI (FALLBACK provider) ----
# If Z.ai is not configured, DeepSeek is used as a fallback.
# Get an API key at: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=your-deepseek-api-key-here

# DeepSeek model (optional — defaults to deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# DeepSeek base URL (optional — defaults to https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# AI rate limits (optional)
# AI_RPM_LIMIT=50          # requests per minute
# AI_RPD_LIMIT=1000         # requests per day
# AI_TOKEN_QUOTA=1000000    # daily token quota

# ---- Admin Account (optional display name) ----
# Shown in the UI as the admin's display name. Defaults to "Administrator".
# ADMIN_NAME=Administrator

# ---- Cron / Background Jobs ----
# Secret required by the /api/students/check-alerts cron endpoint.
# Set this to a long random string and configure your cron job to send it
# as the `authorization` header. Without it, the endpoint returns 401.
# CRON_SECRET=your-cron-secret-here

# ---- Public App URL ----
# Used in email/notification links + cron endpoint absolute URLs.
# On Vercel, this is usually auto-detected — set explicitly only if needed.
# NEXT_PUBLIC_APP_URL=https://examiner-ai-tau.vercel.app

# ---- NotebookLM URL (DEPRECATED — AI Tutor is now a chatbot) ----
# This was used by the old NotebookLM iframe launcher. The AI Tutor tab now
# uses an in-app chatbot (/api/ai/tutor) and does NOT need this URL.
# Left here for backward compatibility — safe to leave unset.
# NEXT_PUBLIC_NOTEBOOKLM_URL=https://notebooklm.google.com/notebook/...

# ---- Logging ----
# Log level for the structured logger (src/lib/logger.ts).
# Options: debug | info | warn | error. Defaults to "info".
# LOG_LEVEL=info

# ---- Auto-managed (do not set manually) ----
# NODE_ENV — set automatically by Next.js (development | production)
# VERCEL_ENV — set automatically by Vercel (development | preview | production)
# Stripe (optional — leave empty for free enrollment on paid courses)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
