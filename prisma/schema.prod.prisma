model LearnNarration {
  id        String   @id @default(cuid())
  slideId   String
  level     Int      // 1-4
  language  String   @default("en")
  text      String
  createdAt DateTime @default(now())
  slide LearnSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)
