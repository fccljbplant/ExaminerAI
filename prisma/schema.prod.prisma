// ExaminerAI — Prisma schema (PostgreSQL for Vercel production)
//
// Course-Centric Architecture (mirrors prisma/schema.prisma)
// - Batch/BatchTeacher removed
// - Role "teacher" renamed to "instructor"
// - NotebookLM removed
// - CourseEnrollment replaces batch-based student/instructor assignment

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CourseEnrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  role       String // "student" | "instructor"
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, role])
  @@index([userId])
  @@index([courseId])
  @@index([role])
}

model Course {
  id                          String   @id @default(cuid())
  name                        String   @unique
  description                 String   @default("")
  isActive                    Boolean  @default(true)
  domain                      String   @default("technology")
  level                       String   @default("beginner")
  toolsUsed                   String   @default("[]")
  deliverableTypes            String   @default("[]")
  assessmentType              String   @default("socratic")
  assessmentConfigJson        String?
  journeyStepsJson            String?
  projectTemplateJson         String?
  aiPromptsJson               String?
  testConfigJson              String?
  reportCardTemplateJson      String?
  subjects                    String   @default("[]")
  projectEnabled              Boolean  @default(false)
  projectRequired             Boolean  @default(false)
  projectDefaultDurationWeeks Int      @default(4)
  isDefault                   Boolean  @default(false)

  // Marketplace fields (Phase 6 — professional course platform)
  subtitle         String?
  category         String   @default("technology")  // web-dev, cloud, data, mobile, security, soft-skills
  price            Float    @default(0)              // 0 = free
  currency         String   @default("USD")
  durationWeeks    Int      @default(6)
  language         String   @default("en")
  thumbnailUrl     String?
  trailerVideoUrl  String?
  rating           Float    @default(0)
  reviewCount      Int      @default(0)
  enrollmentCount  Int      @default(0)
  published        Boolean  @default(false)          // visible on marketplace?
  featured         Boolean  @default(false)          // shown on homepage?
  instructorName   String?                           // display name for marketing
  instructorBio    String?                           // short bio
  skillsVerified   String   @default("[]")           // JSON: ["JavaScript", "React", ...]
  whatYouWillLearn String   @default("[]")           // JSON: ["Build a REST API", ...]
  prerequisites    String   @default("[]")           // JSON: ["Basic HTML", ...]

  institutionId               String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  // Marketplace revenue tracking — aggregates of all Payment rows for this
  // course. Updated on every successful payment.
  instructorEarnings Float @default(0)  // total earnings paid out to instructors (80% share)
  platformFee       Float @default(0)  // platform's 20% cut

  weeks              CourseWeek[]
  enrollments        CourseEnrollment[]
  certificates       Certificate[]
  reviews            CourseReview[]
  institution        Institution?         @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  events             Event[]
  groupTasks         GroupTask[]
  dailyLogs          DailyLog[]
  projectTasks       ProjectTask[]
  projectWeeks       ProjectWeek[]
  projectReports     ProjectReport[]
  interactions       Interaction[]
  weeklyTests        WeeklyTest[]
  reportCards        ReportCard[]
  dailyTests         DailyTest[]
  curriculumProgress CurriculumProgress[]
  learningPathCourses LearningPathCourse[]
  payments           Payment[]
  faqs               CourseFAQ[]
}

/// Course reviews — students rate courses after completion.
/// One review per user per course (@@unique on [userId, courseId]).
model CourseReview {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  rating      Int      // 1-5 stars
  title       String
  content     String
  helpful     Int      @default(0)  // upvote count
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  votes  CourseReviewHelpfulVote[]

  @@unique([userId, courseId])  // one review per user per course
  @@index([courseId])
}

/// Per-user helpful-vote tracking — one vote per user per review.
/// Lets us enforce "one upvote per user" without a JSON blob on CourseReview.
model CourseReviewHelpfulVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review CourseReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
}

/// Course FAQs — common questions and answers displayed on course detail page.
model CourseFAQ {
  id          String   @id @default(cuid())
  courseId    String
  question    String
  answer      String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

/// A learning path — a sequence of courses that form a career trajectory.
model LearningPath {
  id          String   @id @default(cuid())
  title       String   @unique
  subtitle    String?
  description String
  category    String   @default("technology")
  icon        String   @default("🎓")
  price       Float    @default(0)     // bundle price (0 = free)
  currency    String   @default("USD")
  durationWeeks Int    @default(12)
  level       String   @default("beginner")
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)

  courses     LearningPathCourse[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, featured])
}

/// Junction table — courses in a learning path, with order.
model LearningPathCourse {
  id              String       @id @default(cuid())
  learningPathId  String
  courseId        String
  order           Int          // 1, 2, 3... — the sequence
  isCapstone      Boolean      @default(false)  // the final project course

  learningPath    LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  course          Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([learningPathId, courseId])
  @@index([learningPathId, order])
}

model CourseWeek {
  id         String @id @default(cuid())
  courseId   String
  weekNumber Int
  phase      String
  milestone  String @default("")

  course Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  days   CourseDay[]

  @@unique([courseId, weekNumber])
  @@index([courseId])
}

model CourseDay {
  id             String @id @default(cuid())
  courseWeekId   String
  day            Int
  title          String
  objective      String @default("")
  whyItMatters   String @default("")
  topicsCovered  String @default("[]")
  activity       String @default("")
  deliverable    String @default("")
  resources      String @default("[]")
  instructorNote String @default("")
  videoUrl       String?
  videoTitle     String?
  codeExamples   String @default("[]")
  webImages      String @default("[]")

  courseWeek CourseWeek @relation(fields: [courseWeekId], references: [id], onDelete: Cascade)

  @@unique([courseWeekId, day])
  @@index([courseWeekId])
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String
  passwordHash         String
  role                 String    @default("pending")
  blocked              Boolean   @default(false)
  approvedAt           DateTime?
  createdAt            DateTime  @default(now())
  lastLogin            DateTime?
  currentWeek          Int       @default(1)
  currentDay           Int       @default(1)
  selfPacedEnabled     Boolean   @default(true)
  projectName          String?
  projectDescription   String?
  projectType          String?
  projectScope         String?
  projectObjectives    String?
  projectRequirements  String?
  projectBusinessCase  String?
  projectSummary       String?
  projectKeyFeatures   String?
  projectDurationWeeks Int?
  projectStartDate     DateTime?
  projectNotes         String?
  projectGithubUrl     String?
  projectDeployUrl     String?
  journeyProgress      String    @default("[]")
  securityQuestion     String?
  securityAnswer       String?

  enrollments             CourseEnrollment[]
  dailyLogs               DailyLog[]
  tasks                   ProjectTask[]
  projectWeeks            ProjectWeek[]
  projectReports          ProjectReport[]
  interactions            Interaction[]
  weeklyTests             WeeklyTest[]
  competencies            Competency[]
  reportCards             ReportCard[]
  curriculumProgress      CurriculumProgress[]
  commentsGiven           Comment[]              @relation("CommentAuthor")
  commentsRecv            Comment[]              @relation("CommentTarget")
  messagesSent            Message[]              @relation("MsgSender")
  messagesRecv            Message[]              @relation("MsgRecipient")
  resetRequests           PasswordResetRequest[]
  certificates            Certificate[]
  accessGrantsReceived    AccessGrant[]          @relation("AccessGrantGrantee")
  accessGrantsGiven       AccessGrant[]          @relation("AccessGrantGrantor")
  auditLogs               AuditLog[]
  skillMastery            SkillMastery[]
  dailyTests              DailyTest[]
  drillCards              DrillCard[]
  chatSessions            ChatSession[]
  institutionId           String?
  institution             Institution?           @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  groupTaskSubmissions    GroupTaskSubmission[]
  instructorGroupTasks    GroupTask[]            @relation("GroupTaskInstructor")
  guardianLinks           GuardianLink[]         @relation("GuardianLinkGuardian")
  studentGuardians        GuardianLink[]         @relation("GuardianLinkStudent")
  eventsCreated           Event[]
  peerAssessmentsGiven    PeerAssessment[]       @relation("PeerAssessor")
  peerAssessmentsReceived PeerAssessment[]       @relation("PeerAssessee")
  instructorRules         InstructorRule[]       @relation("InstructorRuleOwner")
  milestones              Milestone[]
  courseReviews           CourseReview[]
  reviewVotes             CourseReviewHelpfulVote[]
  notifications           Notification[]
  payments                Payment[]
}

model PasswordResetRequest {
  id           String    @id @default(cuid())
  userId       String
  reason       String    @default("")
  status       String    @default("pending")
  tempPassword String?
  adminNote    String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model DailyLog {
  id                 String   @id @default(cuid())
  userId             String
  date               DateTime @default(now())
  week               Int
  whatDidYouDo       String
  anyErrors          String   @default("")
  confidence         Int      @default(3)
  gitCommit          String?
  learningReflection String   @default("")
  confusionNotes     String   @default("")
  nextQuestion       String   @default("")
  courseId           String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, week])
  @@index([courseId])
}

model ProjectTask {
  id               String    @id @default(cuid())
  userId           String
  description      String
  status           String    @default("planned")
  week             Int
  day              Int?
  dueDate          String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?
  estimatedMinutes Int?
  isMilestone      Boolean   @default(false)
  taskNotes        String?
  timeEstimate     String?
  courseId         String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, week])
  @@index([userId, week, day])
  @@index([courseId])
}

model ProjectWeek {
  id         String   @id @default(cuid())
  userId     String
  weekNumber Int
  title      String
  summary    String   @default("")
  milestones String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  courseId   String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([userId, weekNumber])
  @@index([userId])
  @@index([courseId])
}

model ProjectReport {
  id          String    @id @default(cuid())
  userId      String
  week        Int
  reportType  String    @default("weekly")
  reportText  String
  aiAnalysis  String?
  submittedAt DateTime  @default(now())
  analyzedAt  DateTime?
  courseId    String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, week])
  @@index([courseId])
}

model CurriculumProgress {
  id          String   @id @default(cuid())
  userId      String
  week        Int
  day         Int
  completedAt DateTime @default(now())
  courseId    String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([userId, week, day])
  @@index([userId, week])
  @@index([courseId])
}

model Interaction {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @default(now())
  week             Int
  pillar           String
  topic            String
  question         String
  projectContext   String   @default("")
  studentAnswer    String   @default("")
  timeTakenSeconds Int      @default(0)
  answerLength     Int      @default(0)
  correctness      Int      @default(0)
  feedback         String   @default("")
  level            String   @default("Beginner")
  gaps             String   @default("")
  followUp         String?
  plagiarismScore  Int?
  courseId         String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, week])
  @@index([courseId])
}

model WeeklyTest {
  id              String    @id @default(cuid())
  userId          String
  week            Int
  status          String    @default("locked")
  startedAt       DateTime?
  completedAt     DateTime?
  interactionIds  String    @default("[]")
  score           Int?
  strengths       String    @default("[]")
  weaknesses      String    @default("[]")
  nextAction      String?
  conversation    String    @default("[]")
  currentQuestion Int       @default(0)
  replyCount      Int       @default(0)
  plagiarismScore Int?
  retakeAllowed   Boolean   @default(false)
  courseId        String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([userId, week])
  @@index([courseId])
}

model Competency {
  id            String   @id @default(cuid())
  userId        String
  topic         String
  level         String   @default("Beginner")
  score         Int      @default(0)
  attempts      Int      @default(0)
  lastAssessed  DateTime @default(now())
  weakSubTopics String   @default("[]")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
}

model ReportCard {
  id         String   @id @default(cuid())
  userId     String
  week       Int
  date       DateTime @default(now())
  grade      String
  score      Int
  strengths  String   @default("[]")
  weaknesses String   @default("[]")
  progress   String
  nextSteps  String   @default("[]")
  courseId   String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([userId, week])
  @@index([courseId])
}

model AICache {
  id               String   @id @default(cuid())
  cacheKey         String   @unique
  response         String
  provider         String   @default("deepseek")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  hitCount         Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([cacheKey])
}

model AIUsageLog {
  id               String   @id @default(cuid())
  userId           String?
  provider         String
  model            String
  feature          String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  success          Boolean  @default(true)
  errorMessage     String?
  durationMs       Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([provider, createdAt])
  @@index([feature, createdAt])
  @@index([createdAt])
  @@index([userId, feature, createdAt])
}

model Message {
  id        String    @id @default(cuid())
  fromId    String
  toId      String
  subject   String?
  body      String
  sentAt    DateTime  @default(now())
  isRead    Boolean   @default(false)
  reply     String?
  repliedAt DateTime?

  from User @relation("MsgSender", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("MsgRecipient", fields: [toId], references: [id], onDelete: Cascade)

  @@index([toId, isRead])
  @@index([fromId])
}

model Comment {
  id            String   @id @default(cuid())
  interactionId String?
  taskId        String?
  weeklyTestId  String?
  dailyLogId    String?
  studentId     String
  instructorId  String
  body          String?
  marksOverride Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student    User @relation("CommentTarget", fields: [studentId], references: [id], onDelete: Cascade)
  instructor User @relation("CommentAuthor", fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([interactionId])
  @@index([taskId])
  @@index([weeklyTestId])
  @@index([dailyLogId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Certificate — Verified digital credential.
//
// Phase 6 (marketplace): extended with `credentialId` (public, human-readable
// ID like "TRN-AI-2026-08-NA-87"), `capstonePassed`, `skillsVerified`,
// `distinction`, and `completedAt`. The legacy `verifyToken` (a 64-char hex
// string) is kept for backward-compat with certificates issued before Phase 6.
//
// Issuance criteria:
//   - Student completes all weeks of the course
//   - Final score >= 75
//   - distinction = true when score >= 85
model Certificate {
  id            String   @id @default(cuid())
  userId        String
  courseId      String?
  courseName    String
  studentName   String
  grade         String
  score         Int
  issuedAt      DateTime @default(now())
  signedBy      String
  verifyToken   String   @unique
  pdfUrl        String?
  institutionId String?

  // Phase 6 — marketplace credential fields
  credentialId    String?  @unique  // public ID like "TRN-AI-2026-08-NA-87"
  capstonePassed  Boolean  @default(false)
  skillsVerified  String   @default("[]")  // JSON: ["JavaScript", "React", ...]
  completedAt     DateTime @default(now())
  distinction     Boolean  @default(false)  // "with Distinction" (score >= 85)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
}

/// Professional achievement milestones — skill-verified, NOT consumer gamification.
model Milestone {
  id          String   @id @default(cuid())
  userId      String
  type        String   // course_completion, distinction, capstone_certified, skill_mastery, consistent_performer, peer_recognized, mentor_endorsed
  courseId     String?
  title       String   // "Modern Web Dev & AI Integration — Score: 87"
  description String   // "Completed 6-week professional training program"
  evidence    String   @default("{}")  // JSON: { score, capstoneUrl, skills, ... }
  earnedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, type, courseId])
}

model AccessGrant {
  id              String    @id @default(cuid())
  granteeUserId   String
  scopeType       String
  scopeId         String
  dataScope       String    @default("full")
  grantedByUserId String?
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?

  grantee   User  @relation("AccessGrantGrantee", fields: [granteeUserId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("AccessGrantGrantor", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([granteeUserId, scopeType, scopeId])
  @@index([granteeUserId])
  @@index([scopeType, scopeId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actorName   String
  actorRole   String
  action      String
  targetType  String
  targetId    String
  beforeJson  String?
  afterJson   String?
  metadata    String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model SkillMastery {
  id               String   @id @default(cuid())
  userId           String
  topic            String
  pillar           String
  masteryLevel     String
  evidenceCount    Int      @default(0)
  lastAssessedWeek Int?
  trend            String
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
  @@index([userId, pillar])
  @@index([userId, masteryLevel])
}

model DailyTest {
  id              String            @id @default(cuid())
  userId          String
  date            DateTime          @default(now())
  week            Int
  topic           String
  pillar          String
  questionCount   Int               @default(3)
  score           Int?
  status          String            @default("in_progress")
  currentQuestion Int               @default(0)
  replyCount      Int               @default(0)
  conversation    String            @default("[]")
  difficultyState String            @default("{\"level\":1,\"streak\":0,\"history\":[]}")
  createdAt       DateTime          @default(now())
  courseId        String?
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  answers         DailyTestAnswer[]

  @@unique([userId, date])
  @@index([userId, date])
  @@index([userId, status])
  @@index([courseId])
}

/// Spaced-repetition drill cards generated from wrong answers.
model DrillCard {
  id              String   @id @default(cuid())
  userId          String
  topic           String
  questionDigest  String
  explanation     String   @default("")
  dueAt           DateTime
  attempts        Int      @default(0)
  lastScore       Int      @default(0)
  masteredAt      DateTime?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([userId, masteredAt])
}

model DailyTestAnswer {
  id           String    @id @default(cuid())
  dailyTestId  String
  question     String
  answer       String
  score        Int
  timeTakenSec Int?
  topic        String?
  dailyTest    DailyTest @relation(fields: [dailyTestId], references: [id], onDelete: Cascade)

  @@index([dailyTestId])
}

model GroupTask {
  id           String    @id @default(cuid())
  courseId     String
  instructorId String
  title        String
  description  String    @default("")
  type         String    @default("assignment")
  dueDate      DateTime?
  week         Int?
  status       String    @default("open")
  maxScore     Int       @default(100)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  course          Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher         User                  @relation("GroupTaskInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  submissions     GroupTaskSubmission[]
  peerAssessments PeerAssessment[]

  @@index([courseId, status])
  @@index([instructorId])
  @@index([dueDate])
}

model GroupTaskSubmission {
  id          String    @id @default(cuid())
  groupTaskId String
  userId      String
  content     String    @default("")
  link        String?
  score       Int?
  feedback    String?
  submittedAt DateTime  @default(now())
  gradedAt    DateTime?

  groupTask GroupTask @relation(fields: [groupTaskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupTaskId, userId])
  @@index([groupTaskId])
  @@index([userId])
}

model Event {
  id           String    @id @default(cuid())
  courseId     String
  createdById  String
  title        String
  description  String    @default("")
  type         String    @default("deadline")
  activityType String?
  startDate    DateTime
  endDate      DateTime?
  location     String?
  isAllDay     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([courseId, startDate])
  @@index([startDate])
  @@index([type])
}

model PeerAssessment {
  id            String   @id @default(cuid())
  groupTaskId   String
  assessorId    String
  assesseeId    String
  collaboration Int
  contribution  Int
  communication Int
  reliability   Int
  respect       Int
  textFeedback  String   @default("")
  createdAt     DateTime @default(now())

  groupTask GroupTask @relation(fields: [groupTaskId], references: [id], onDelete: Cascade)
  assessor  User      @relation("PeerAssessor", fields: [assessorId], references: [id], onDelete: Cascade)
  assessee  User      @relation("PeerAssessee", fields: [assesseeId], references: [id], onDelete: Cascade)

  @@unique([groupTaskId, assessorId, assesseeId])
  @@index([groupTaskId])
  @@index([assesseeId])
}

model RoleNavConfig {
  id        String   @id @default(cuid())
  role      String   @unique
  navItems  String   @default("[]")
  updatedAt DateTime @updatedAt
}

model GuardianLink {
  id           String   @id @default(cuid())
  guardianId   String
  studentId    String
  relationship String   @default("parent")
  createdAt    DateTime @default(now())

  guardian User @relation("GuardianLinkGuardian", fields: [guardianId], references: [id], onDelete: Cascade)
  student  User @relation("GuardianLinkStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([guardianId])
  @@index([studentId])
}

model InstructorRule {
  id           String   @id @default(cuid())
  instructorId String
  condition    String
  action       String
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  instructor   User     @relation("InstructorRuleOwner", fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId, enabled])
}

model ChatSession {
  id              String    @id @default(cuid())
  userId          String
  chatbotType     String
  week            Int?
  topic           String?
  status          String    @default("in_progress")
  score           Int?
  totalQuestions  Int?
  currentQuestion Int       @default(0)
  conversation    String    @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, chatbotType])
  @@index([userId, status])
  @@index([chatbotType, status])
  @@index([createdAt])
}

model Institution {
  id           String   @id @default(cuid())
  name         String
  logoUrl      String?
  contactEmail String
  createdAt    DateTime @default(now())

  users        User[]
  courses      Course[]
  certificates Certificate[]
}

// ============================================================
// In-app notifications — bell-icon notifications stored in the DB.
// Future: a webhook (Resend, SendGrid, etc.) can be wired to send real
// emails by reading these rows + the user's email address.
// ============================================================
model Notification {
  id        String   @id @default(cuid())
  userId    String
  // type values: enrollment | course_completed | credential_earned |
  //              message_received | milestone_earned
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  // Optional deep link — where the bell should send the user when clicked.
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ============================================================
// Payments — every successful marketplace purchase creates a row here.
// Revenue split: platformFee (20%) + instructorShare (80%) = amount.
// Course.instructorEarnings / Course.platformFee are running totals
// derived from this table (incremented on each successful payment).
// ============================================================
model Payment {
  id              String   @id @default(cuid())
  userId          String   // student who paid
  courseId        String
  amount          Float
  currency        String   @default("USD")
  platformFee     Float    // 20% of amount
  instructorShare Float    // 80% of amount
  status          String   @default("completed") // completed, refunded, pending
  createdAt       DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([userId])
}
