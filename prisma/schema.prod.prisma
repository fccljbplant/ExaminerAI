model JourneyStep {
  id          String   @id @default(cuid())
  journeyId   String
  stepOrder   Int
  stepType    String   // slide | daily_test | weekly_test | project_milestone | completion
  slideId     String?
  title       String
  description String?
  status      String   @default("pending") // pending | active | completed
  xpReward    Int      @default(5)
  completedAt DateTime?
  metadata    Json?
  journey JourneyPlan @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  @@index([journeyId, stepOrder])
}

model LearnSlide {
  id           String   @id @default(cuid())
  courseId     String
  moduleId     String?
  lessonId     String?
  slideOrder   Int
  title        String
  bullets      Json     // string[]
  visualSpec   String?
  keyTerms     Json     // string[]
  checkQuestion String?
  realWorldExample String?
  analogy      String?
  createdAt    DateTime @default(now())
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
