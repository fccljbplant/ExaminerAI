// ExaminerAI — Prisma schema (PostgreSQL for Vercel production)
//
// Course-Centric Architecture (mirrors prisma/schema.prisma)
// - Batch/BatchTeacher removed
// - Role "teacher" renamed to "instructor"
// - NotebookLM removed
// - CourseEnrollment replaces batch-based student/instructor assignment

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CourseEnrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  role       String   // "student" | "instructor"
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, role])
  @@index([userId])
  @@index([courseId])
  @@index([role])
}

model Course {
  id                     String   @id @default(cuid())
  name                   String   @unique
  description            String   @default("")
  isActive               Boolean  @default(true)
  domain                 String   @default("technology")
  level                  String   @default("beginner")
  toolsUsed              String   @default("[]")
  deliverableTypes       String   @default("[]")
  assessmentType         String   @default("socratic")
  assessmentConfigJson   String?
  journeyStepsJson       String?
  projectTemplateJson    String?
  aiPromptsJson          String?
  testConfigJson         String?
  reportCardTemplateJson String?
  subjects               String   @default("[]")
  projectEnabled              Boolean  @default(false)
  projectRequired             Boolean  @default(false)
  projectDefaultDurationWeeks Int      @default(4)
  isDefault                   Boolean  @default(false)
  institutionId          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  weeks       CourseWeek[]
  enrollments CourseEnrollment[]
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  events      Event[]
  groupTasks  GroupTask[]
  dailyLogs   DailyLog[]
  projectTasks ProjectTask[]
  projectWeeks ProjectWeek[]
  projectReports ProjectReport[]
  interactions Interaction[]
  weeklyTests  WeeklyTest[]
  reportCards  ReportCard[]
  dailyTests   DailyTest[]
  curriculumProgress CurriculumProgress[]
}

model CourseWeek {
  id         String @id @default(cuid())
  courseId   String
  weekNumber Int
  phase      String
  milestone  String @default("")

  course Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  days   CourseDay[]

  @@unique([courseId, weekNumber])
  @@index([courseId])
}

model CourseDay {
  id            String @id @default(cuid())
  courseWeekId  String
  day           Int
  title         String
  objective     String @default("")
  whyItMatters  String @default("")
  topicsCovered String @default("[]")
  activity      String @default("")
  deliverable   String @default("")
  resources     String @default("[]")
  teacherNote   String @default("")

  courseWeek CourseWeek @relation(fields: [courseWeekId], references: [id], onDelete: Cascade)

  @@unique([courseWeekId, day])
  @@index([courseWeekId])
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String
  passwordHash         String
  role                 String    @default("pending")
  blocked              Boolean   @default(false)
  approvedAt           DateTime?
  createdAt            DateTime  @default(now())
  lastLogin            DateTime?
  currentWeek          Int       @default(1)
  currentDay           Int       @default(1)
  selfPacedEnabled     Boolean   @default(true)
  projectName          String?
  projectDescription   String?
  projectType          String?
  projectScope         String?
  projectObjectives    String?
  projectRequirements  String?
  projectBusinessCase  String?
  projectSummary       String?
  projectKeyFeatures   String?
  projectDurationWeeks Int?
  projectStartDate     DateTime?
  projectNotes         String?
  projectGithubUrl     String?
  projectDeployUrl     String?
  journeyProgress      String    @default("[]")
  securityQuestion     String?
  securityAnswer       String?

  enrollments             CourseEnrollment[]
  dailyLogs               DailyLog[]
  tasks                   ProjectTask[]
  projectWeeks            ProjectWeek[]
  projectReports          ProjectReport[]
  interactions            Interaction[]
  weeklyTests             WeeklyTest[]
  competencies            Competency[]
  reportCards             ReportCard[]
  psychObs                PsychologyObs[]
  curriculumProgress      CurriculumProgress[]
  commentsGiven           Comment[]              @relation("CommentAuthor")
  commentsRecv            Comment[]              @relation("CommentTarget")
  messagesSent            Message[]              @relation("MsgSender")
  messagesRecv            Message[]              @relation("MsgRecipient")
  resetRequests           PasswordResetRequest[]
  certificates            Certificate[]
  accessGrantsReceived    AccessGrant[]          @relation("AccessGrantGrantee")
  accessGrantsGiven       AccessGrant[]          @relation("AccessGrantGrantor")
  auditLogs               AuditLog[]
  confidenceRatings       ConfidenceRating[]
  wellbeingState          WellbeingState?
  crisisFlags             CrisisFlag[]
  psychEvidence           PsychEvidence[]
  skillMastery            SkillMastery[]
  mentorshipTouchpoints   MentorshipTouchpoint[]
  dailyTests              DailyTest[]
  chatSessions            ChatSession[]
  healthSummary           StudentHealthSummary?
  institutionId           String?
  institution             Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  growthReport            GrowthReport?
  studentAlerts           StudentAlert[]
  groupTaskSubmissions    GroupTaskSubmission[]
  groupTasksTaught        GroupTask[]            @relation("GroupTaskTeacher")
  guardianLinks           GuardianLink[]         @relation("GuardianLinkGuardian")
  studentGuardians        GuardianLink[]         @relation("GuardianLinkStudent")
  eventsCreated           Event[]
  peerAssessmentsGiven    PeerAssessment[]       @relation("PeerAssessor")
  peerAssessmentsReceived PeerAssessment[]       @relation("PeerAssessee")
  teacherRules            TeacherRule[]          @relation("TeacherRuleOwner")
  caseReviewsPosted       CaseReview[]           @relation("CaseReviewAuthor")
  caseReviewResponses     CaseReviewResponse[]   @relation("CaseReviewResponder")
}

model PasswordResetRequest {
  id           String    @id @default(cuid())
  userId       String
  reason       String    @default("")
  status       String    @default("pending")
  tempPassword String?
  adminNote    String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model DailyLog {
  id                 String   @id @default(cuid())
  userId             String
  date               DateTime @default(now())
  week               Int
  whatDidYouDo       String
  anyErrors          String   @default("")
  confidence         Int      @default(3)
  gitCommit          String?
  learningReflection String   @default("")
  confusionNotes     String   @default("")
  nextQuestion       String @default("")
  courseId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, week])
  @@index([courseId])
}

model ProjectTask {
  id               String   @id @default(cuid())
  userId           String
  description      String
  status           String   @default("planned")
  week             Int
  day              Int?
  dueDate          String?
  createdAt        DateTime @default(now())
  completedAt      DateTime?
  estimatedMinutes Int?
  isMilestone      Boolean  @default(false)
  taskNotes        String?
  timeEstimate String?
  courseId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, week])
  @@index([userId, week, day])
  @@index([courseId])
}

model ProjectWeek {
  id         String   @id @default(cuid())
  userId     String
  weekNumber Int
  title      String
  summary    String   @default("")
  milestones String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  courseId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([userId, weekNumber])
  @@index([userId])
  @@index([courseId])
}

model ProjectReport {
  id          String    @id @default(cuid())
  userId      String
  week        Int
  reportType  String    @default("weekly")
  reportText  String
  aiAnalysis  String?
  submittedAt DateTime  @default(now())
  analyzedAt  DateTime?
  courseId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, week])
  @@index([courseId])
}

model CurriculumProgress {
  id          String   @id @default(cuid())
  userId      String
  week        Int
  day         Int
  completedAt DateTime @default(now())
  courseId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([userId, week, day])
  @@index([userId, week])
  @@index([courseId])
}

model Interaction {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @default(now())
  week             Int
  pillar           String
  topic            String
  question         String
  projectContext   String   @default("")
  studentAnswer    String   @default("")
  timeTakenSeconds Int      @default(0)
  answerLength     Int      @default(0)
  correctness      Int      @default(0)
  feedback         String   @default("")
  level            String   @default("Beginner")
  gaps             String   @default("")
  followUp         String?
  cognitiveLoad    String   @default("moderate")
  confidence       String   @default("moderate")
  metacognitive    String   @default("moderate")
  plagiarismScore  Int?
  courseId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, week])
  @@index([courseId])
}

model WeeklyTest {
  id             String    @id @default(cuid())
  userId         String
  week           Int
  status         String    @default("locked")
  startedAt      DateTime?
  completedAt    DateTime?
  interactionIds String    @default("[]")
  score          Int?
  strengths      String    @default("[]")
  weaknesses     String    @default("[]")
  examinerObs    String?
  nextAction     String?
  conversation    String  @default("[]")
  currentQuestion Int     @default(0)
  replyCount      Int     @default(0)
  psychAnalysis   String?
  examinerComment String?
  plagiarismScore Int?
  retakeAllowed Boolean @default(false)
  courseId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([userId, week])
  @@index([courseId])
}

model Competency {
  id            String   @id @default(cuid())
  userId        String
  topic         String
  level         String   @default("Beginner")
  score         Int      @default(0)
  attempts      Int      @default(0)
  lastAssessed  DateTime @default(now())
  weakSubTopics String   @default("[]")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
}

model ReportCard {
  id                   String   @id @default(cuid())
  userId               String
  week                 Int
  date                 DateTime @default(now())
  grade                String
  score                Int
  strengths            String   @default("[]")
  weaknesses           String   @default("[]")
  workHabits           String
  progress             String
  nextSteps            String   @default("[]")
  examinerObservations String
  courseId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([userId, week])
  @@index([courseId])
}

model PsychologyObs {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime @default(now())
  week          Int
  confidence    String   @default("moderate")
  communication String   @default("")
  learningCurve String   @default("")
  engagement    String   @default("")
  cognitiveLoad String   @default("moderate")
  metacognitive String   @default("moderate")
  remarks       String   @default("")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, week])
}

model AICache {
  id               String   @id @default(cuid())
  cacheKey         String   @unique
  response         String
  provider         String   @default("deepseek")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  hitCount         Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([cacheKey])
}

model AIUsageLog {
  id               String   @id @default(cuid())
  userId           String?
  provider         String
  model            String
  feature          String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  success          Boolean  @default(true)
  errorMessage     String?
  durationMs       Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([provider, createdAt])
  @@index([feature, createdAt])
  @@index([createdAt])
  @@index([userId, feature, createdAt])
}

model Message {
  id        String    @id @default(cuid())
  fromId    String
  toId      String
  subject   String?
  body      String
  sentAt    DateTime  @default(now())
  isRead    Boolean   @default(false)
  reply     String?
  repliedAt DateTime?

  from User @relation("MsgSender", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("MsgRecipient", fields: [toId], references: [id], onDelete: Cascade)

  @@index([toId, isRead])
  @@index([fromId])
}

model Comment {
  id            String   @id @default(cuid())
  interactionId String?
  taskId        String?
  weeklyTestId  String?
  dailyLogId    String?
  studentId     String
  instructorId   String
  body          String?
  marksOverride Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student   User @relation("CommentTarget", fields: [studentId], references: [id], onDelete: Cascade)
  instructor User @relation("CommentAuthor", fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([interactionId])
  @@index([taskId])
  @@index([weeklyTestId])
  @@index([dailyLogId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Certificate {
  id          String   @id @default(cuid())
  userId      String
  courseId    String?
  courseName  String
  studentName String
  grade       String
  score       Int
  issuedAt    DateTime @default(now())
  signedBy    String
  verifyToken String   @unique
  pdfUrl        String?
  institutionId String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution  Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model AccessGrant {
  id              String    @id @default(cuid())
  granteeUserId   String
  scopeType       String
  scopeId         String
  dataScope       String    @default("full")
  grantedByUserId String?
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?

  grantee   User  @relation("AccessGrantGrantee", fields: [granteeUserId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("AccessGrantGrantor", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([granteeUserId, scopeType, scopeId])
  @@index([granteeUserId])
  @@index([scopeType, scopeId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actorName   String
  actorRole   String
  action      String
  targetType  String
  targetId    String
  beforeJson  String?
  afterJson   String?
  metadata    String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model ConfidenceRating {
  id          String   @id @default(cuid())
  userId      String
  source      String
  rating      Int
  actualScore Int?
  context     String?
  week        Int?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WellbeingState {
  id          String   @id @default(cuid())
  userId      String   @unique
  tier        String
  reasonsJson String   @default("[]")
  detectedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tier])
}

model CrisisFlag {
  id          String    @id @default(cuid())
  userId      String
  flaggedBy   String
  category    String
  severity    String
  status      String    @default("open")
  evidenceRef String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([severity, status])
}

model PsychEvidence {
  id           String   @id @default(cuid())
  userId       String
  dimension    String
  value        String
  evidenceText String
  sourceType   String
  sourceId     String?
  week         Int?
  disputed     Boolean  @default(false)
  disputeNote  String?
  disputedBy   String?
  disputedAt   DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dimension])
  @@index([userId, createdAt])
}

model SkillMastery {
  id               String   @id @default(cuid())
  userId           String
  topic            String
  pillar           String
  masteryLevel     String
  evidenceCount    Int      @default(0)
  lastAssessedWeek Int?
  trend            String
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
  @@index([userId, pillar])
  @@index([userId, masteryLevel])
}

model MentorshipTouchpoint {
  id             String    @id @default(cuid())
  userId         String
  actorUserId    String
  type           String
  relatedAlertId String?
  note           String
  outcome        String?
  followUpDate   DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([actorUserId])
  @@index([type])
}

model DailyTest {
  id                     String            @id @default(cuid())
  userId                 String
  date                   DateTime          @default(now())
  week                   Int
  topic                  String
  pillar                 String
  questionCount          Int               @default(3)
  score                  Int?
  status                 String            @default("in_progress")
  psychAnalysisGenerated Boolean           @default(false)
  currentQuestion        Int               @default(0)
  replyCount             Int               @default(0)
  conversation           String            @default("[]")
  createdAt              DateTime          @default(now())
  courseId String?
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                 Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  answers                DailyTestAnswer[]

  @@unique([userId, date])
  @@index([userId, date])
  @@index([userId, status])
  @@index([courseId])
}

model DailyTestAnswer {
  id               String    @id @default(cuid())
  dailyTestId      String
  question         String
  answer           String
  score            Int
  timeTakenSec     Int?
  confidenceRating String?
  topic            String?
  dailyTest        DailyTest @relation(fields: [dailyTestId], references: [id], onDelete: Cascade)

  @@index([dailyTestId])
}

model GroupTask {
  id          String    @id @default(cuid())
  courseId    String
  teacherId   String
  title       String
  description String    @default("")
  type        String    @default("assignment")
  dueDate     DateTime?
  week        Int?
  status      String    @default("open")
  maxScore    Int       @default(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  course          Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher         User                  @relation("GroupTaskTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  submissions     GroupTaskSubmission[]
  peerAssessments PeerAssessment[]

  @@index([courseId, status])
  @@index([teacherId])
  @@index([dueDate])
}

model GroupTaskSubmission {
  id          String    @id @default(cuid())
  groupTaskId String
  userId      String
  content     String    @default("")
  link        String?
  score       Int?
  feedback    String?
  submittedAt DateTime  @default(now())
  gradedAt    DateTime?

  groupTask GroupTask @relation(fields: [groupTaskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupTaskId, userId])
  @@index([groupTaskId])
  @@index([userId])
}

model Event {
  id           String    @id @default(cuid())
  courseId     String
  createdById  String
  title        String
  description  String    @default("")
  type         String    @default("deadline")
  activityType String?
  startDate    DateTime
  endDate      DateTime?
  location     String?
  isAllDay     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([courseId, startDate])
  @@index([startDate])
  @@index([type])
}

model PeerAssessment {
  id            String   @id @default(cuid())
  groupTaskId   String
  assessorId    String
  assesseeId    String
  collaboration Int
  contribution  Int
  communication Int
  reliability   Int
  respect       Int
  textFeedback  String   @default("")
  createdAt     DateTime @default(now())

  groupTask GroupTask @relation(fields: [groupTaskId], references: [id], onDelete: Cascade)
  assessor  User      @relation("PeerAssessor", fields: [assessorId], references: [id], onDelete: Cascade)
  assessee  User      @relation("PeerAssessee", fields: [assesseeId], references: [id], onDelete: Cascade)

  @@unique([groupTaskId, assessorId, assesseeId])
  @@index([groupTaskId])
  @@index([assesseeId])
}

model RoleNavConfig {
  id        String   @id @default(cuid())
  role      String   @unique
  navItems  String   @default("[]")
  updatedAt DateTime @updatedAt
}

model GuardianLink {
  id           String   @id @default(cuid())
  guardianId   String
  studentId    String
  relationship String   @default("parent")
  createdAt    DateTime @default(now())

  guardian User @relation("GuardianLinkGuardian", fields: [guardianId], references: [id], onDelete: Cascade)
  student  User @relation("GuardianLinkStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([guardianId])
  @@index([studentId])
}

model TeacherRule {
  id           String   @id @default(cuid())
  instructorId String
  condition    String
  action       String
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  instructor   User     @relation("TeacherRuleOwner", fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId, enabled])
}

model CaseReview {
  id             String               @id @default(cuid())
  postedBy       String
  patternSummary String
  responses      CaseReviewResponse[]
  status         String               @default("open")
  createdAt      DateTime             @default(now())
  postedByUser   User                 @relation("CaseReviewAuthor", fields: [postedBy], references: [id], onDelete: Cascade)

  @@index([status])
}

model CaseReviewResponse {
  id           String     @id @default(cuid())
  caseReviewId String
  responderId  String
  content      String
  createdAt    DateTime   @default(now())
  caseReview   CaseReview @relation(fields: [caseReviewId], references: [id], onDelete: Cascade)
  responder    User       @relation("CaseReviewResponder", fields: [responderId], references: [id], onDelete: Cascade)

  @@index([caseReviewId])
}

model StudentHealthSummary {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  tutorMessagesThisWeek  Int       @default(0)
  tutorMessagesLastWeek  Int       @default(0)
  tutorMessagesTotal     Int       @default(0)
  testsThisWeek          Int       @default(0)
  testsLastWeek          Int       @default(0)
  avgScoreThisWeek       Float?
  avgScoreLastWeek       Float?
  avgScoreOverall        Float?
  engagementStreak       Int       @default(0)
  lastActiveDate         DateTime?
  lastTutorActiveAt      DateTime?
  lastTutorLanguage      String?
  lastTutorTopic         String?
  wellbeingTier          String    @default("green")
  moodScore              Int       @default(50)
  engagementScore        Int       @default(50)
  frustrationCount       Int       @default(0)
  avoidanceCount         Int       @default(0)
  enthusiasmCount        Int       @default(0)
  needsPsychAlert        Boolean   @default(false)
  needsEducationalAlert  Boolean   @default(false)
  needsMentorshipAlert   Boolean   @default(false)
  alertReasonsJson       String    @default("[]")
  weekRolloverAt         DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([wellbeingTier])
  @@index([lastActiveDate])
}

model StudentAlert {
  id              String    @id @default(cuid())
  userId          String
  type            String
  severity        String    @default("amber")
  reason          String
  metric          String
  metricValue     String
  status          String    @default("open")
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNote  String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status])
  @@index([type, status])
  @@index([createdAt])
}

model ChatSession {
  id                String    @id @default(cuid())
  userId            String
  chatbotType       String
  week              Int?
  topic             String?
  status            String    @default("in_progress")
  score             Int?
  totalQuestions    Int?
  currentQuestion   Int       @default(0)
  conversation      String    @default("[]")
  behavioralSignals String?
  psychAnalysis     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, chatbotType])
  @@index([userId, status])
  @@index([chatbotType, status])
  @@index([createdAt])
}

model Institution {
  id            String   @id @default(cuid())
  name          String
  logoUrl       String?
  contactEmail  String
  createdAt     DateTime @default(now())

  users         User[]
  courses       Course[]
  certificates  Certificate[]
}

model GrowthReport {
  id                String   @id @default(cuid())
  userId            String   @unique
  courseId          String?
  generatedAt       DateTime @default(now())
  strengths         String
  growthAreas       String
  dimensionSnapshot String
  behavioralNotes   String?

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}