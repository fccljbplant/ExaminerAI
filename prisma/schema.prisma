// ExaminerAI - Prisma schema for comprehensive demo

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// Users & Roles
// ============================================================

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String   @default("demo123") // plaintext for demo only
  name            String
  role            String   @default("STUDENT") // STUDENT | TEACHER | COUNSELOR | PRINCIPAL | ADMIN | MENTOR | DEVELOPER
  isDemo          Boolean  @default(false)
  isActive        Boolean  @default(true)
  avatar          String?
  phone           String?
  bio             String?
  institutionId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution? @relation(fields: [institutionId], references: [id])

  // Student-specific
  enrollments     Enrollment[]
  grades          Grade[]
  attendances     Attendance[]
  submissions     Submission[]
  alertsFrom      Alert[]       @relation("AlertFrom")
  alertsTo        Alert[]       @relation("AlertTo")
  mentorSessionsStudent MentorSession[] @relation("MentorSessionStudent")
  mentorSessionsMentor  MentorSession[] @relation("MentorSessionMentor")
  messagesFrom    Message[]     @relation("MessageFrom")
  messagesTo      Message[]     @relation("MessageTo")

  // Teacher-specific
  coursesTeaching Course[]
  batchesTeaching Batch[]       @relation("BatchTeacher")
  sessionsLed     ClassSession[]

  // Counsellor
  counselledStudents StudentCounsellorAssignment[] @relation("CounsellorAssignment")
  counselledBy       StudentCounsellorAssignment[] @relation("CounsellorOf")

  // Activity
  auditLogs       AuditLog[]
  interactions    Interaction[]
}

model Institution {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  phone       String?
  email       String?
  logo        String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  courses     Course[]
  batches     Batch[]
  growthReports GrowthReport[]
}

model GrowthReport {
  id              String   @id @default(cuid())
  userId          String
  institutionId   String
  title           String
  content         String
  period          String   // e.g. "Q1 2026"
  visibility      String   @default("PRIVATE")
  createdAt       DateTime @default(now())

  user            User         @relation(fields: [userId], references: [id])
  institution     Institution  @relation(fields: [institutionId], references: [id])
}

// ============================================================
// Courses, Batches, Enrollments
// ============================================================

model Course {
  id              String   @id @default(cuid())
  code            String   @unique
  title           String
  description     String
  outline         String   // markdown outline
  credits         Int      @default(3)
  semester        String
  level           String   @default("Undergraduate")
  teacherId       String?
  institutionId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teacher         User?       @relation(fields: [teacherId], references: [id])
  institution     Institution? @relation(fields: [institutionId], references: [id])
  batches         Batch[]
  enrollments     Enrollment[]
  assessments     Assessment[]
  assignments     Assignment[]
  sessions        ClassSession[]
  timelineEvents  TimelineEvent[]
}

model Batch {
  id              String   @id @default(cuid())
  name            String
  courseId        String
  deliveryMode    String   @default("ON_CAMPUS") // ON_CAMPUS | ONLINE | HYBRID
  room            String?
  schedule        String?
  startDate       DateTime
  endDate         DateTime
  createdAt       DateTime @default(now())

  course          Course     @relation(fields: [courseId], references: [id])
  institution     Institution? @relation(fields: [institutionId], references: [id])
  institutionId   String?
  teachers        User[]     @relation("BatchTeacher")
  enrollments     Enrollment[]
  sessions        ClassSession[]
}

model Enrollment {
  id          String   @id @default(cuid())
  studentId   String
  courseId    String
  batchId     String?
  enrolledAt  DateTime @default(now())
  status      String   @default("ACTIVE") // ACTIVE | COMPLETED | DROPPED
  finalGrade  String?

  student     User     @relation(fields: [studentId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])
  batch       Batch?   @relation(fields: [batchId], references: [id])
}

// ============================================================
// Class sessions, Attendance, Assessments, Grades
// ============================================================

model ClassSession {
  id          String   @id @default(cuid())
  batchId     String
  courseId    String
  teacherId   String?
  date        DateTime
  topic       String
  mode        String   @default("ON_CAMPUS")
  createdAt   DateTime @default(now())

  batch       Batch    @relation(fields: [batchId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])
  teacher     User?    @relation(fields: [teacherId], references: [id])
  attendances Attendance[]
}

model Attendance {
  id          String   @id @default(cuid())
  sessionId   String
  studentId   String
  status      String   // PRESENT | ABSENT | LATE | EXCUSED
  notes       String?
  createdAt   DateTime @default(now())

  session     ClassSession @relation(fields: [sessionId], references: [id])
  student     User         @relation(fields: [studentId], references: [id])
}

model Assessment {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  type        String   // QUIZ | ASSIGNMENT | MIDTERM | FINAL | PROJECT
  maxMarks    Float
  weightage   Float    // percentage contribution to final grade
  date        DateTime
  createdAt   DateTime @default(now())

  course      Course   @relation(fields: [courseId], references: [id])
  grades      Grade[]
}

model Grade {
  id           String   @id @default(cuid())
  assessmentId String
  studentId    String
  marks        Float
  feedback     String?
  createdAt    DateTime @default(now())

  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  student      User       @relation(fields: [studentId], references: [id])
}

model Assignment {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String
  dueDate     DateTime
  maxMarks    Float    @default(100)
  createdAt   DateTime @default(now())

  course      Course      @relation(fields: [courseId], references: [id])
  submissions Submission[]
}

model Submission {
  id          String   @id @default(cuid())
  assignmentId String
  studentId   String
  content     String
  status      String   @default("SUBMITTED") // SUBMITTED | GRADED | LATE | RETURNED
  marks       Float?
  feedback    String?
  submittedAt DateTime @default(now())

  assignment  Assignment @relation(fields: [assignmentId], references: [id])
  student     User       @relation(fields: [studentId], references: [id])
}

// ============================================================
// Alerts (teacher → student/counsellor), with responses
// ============================================================

model Alert {
  id          String   @id @default(cuid())
  type        String   // ACADEMIC | ATTENDANCE | BEHAVIOURAL | WELLBEING | PERFORMANCE
  severity    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  message     String
  courseId    String?
  studentId   String?
  fromUserId  String
  toUserId    String
  status      String   @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED
  response    String?
  respondedAt DateTime?
  createdAt   DateTime @default(now())

  fromUser    User     @relation("AlertFrom", fields: [fromUserId], references: [id])
  toUser      User     @relation("AlertTo", fields: [toUserId], references: [id])
}

// ============================================================
// Counsellor assignments + Mentor sessions (psychological + educational)
// ============================================================

model StudentCounsellorAssignment {
  id            String   @id @default(cuid())
  studentId     String
  counsellorId  String
  assignedAt    DateTime @default(now())
  reason        String?
  status        String   @default("ACTIVE")

  student       User     @relation(fields: [studentId], references: [id])
  counsellor    User     @relation(fields: [counsellorId], references: [id])
}

model MentorSession {
  id           String   @id @default(cuid())
  mentorId     String
  studentId    String
  type         String   // PSYCHOLOGICAL | EDUCATIONAL
  date         DateTime
  duration     Int      // minutes
  goal         String?
  reality      String?
  options      String?
  will         String?
  mood         String?  // HAPPY | NEUTRAL | ANXIOUS | SAD | STRESSED | MOTIVATED
  notes        String
  followUp     String?
  createdAt    DateTime @default(now())

  mentor       User     @relation("MentorSessionMentor", fields: [mentorId], references: [id])
  student      User     @relation("MentorSessionStudent", fields: [studentId], references: [id])
}

// ============================================================
// Messaging + Course Timeline + Audit Log + Interactions
// ============================================================

model Message {
  id          String   @id @default(cuid())
  fromId      String
  toId        String
  content     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  fromUser    User     @relation("MessageFrom", fields: [fromId], references: [id])
  toUser      User     @relation("MessageTo", fields: [toId], references: [id])
}

model TimelineEvent {
  id          String   @id @default(cuid())
  courseId    String
  type        String   // LECTURE | ASSIGNMENT | QUIZ | MILESTONE | RESOURCE | AI_GENERATED
  title       String
  description String?
  date        DateTime
  meta        String?  // JSON-encoded extras

  course      Course   @relation(fields: [courseId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  meta        String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

model Interaction {
  id          String   @id @default(cuid())
  userId      String
  type        String   // LOGIN | VIEW | CLICK | SUBMIT | DOWNLOAD
  target      String?
  meta        String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}
